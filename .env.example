# Optional: defaults work without .env. Keep real values and private files out of Git.
MOA_VERSION=latest
MOA_IMAGE_OWNER=sidetool
MOA_DATA_PATH=moa-data
MOA_AUTH_DATA_PATH=moa-auth-data
MOA_AUTH_CONFIG_PATH=moa-auth-config
MOA_CONNECTOR_DATA_PATH=moa-connector-data
MOA_CONNECTOR_SECRET_PATH=moa-connector-secret
# APK runtime is included; a token is generated automatically in this volume.
MOA_APK_SECRET_PATH=moa-apk-secret
COMPOSE_FILE=compose.yaml
MOA_BIND_ADDRESS=0.0.0.0
MOA_GATEWAY_PORT=8796
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=
PUBLIC_SCHEME=http
# Nginx variable, kept literal. Use the trusted edge's header only behind that edge.
GATEWAY_CLIENT_IP='$remote_addr'
MEDIA_PATH=moa-media
MEDIA_CONTAINER_PATH=/media/library
MOA_MAX_TRANSCODES=2
MOA_TMDB_TOKEN=
MOA_TMDB_API_KEY=
# Optional trailer precheck; can also be configured in the admin UI.
MOA_YOUTUBE_API_KEY=

# Legacy token-file compatibility only: retain :compose.aniyomi.yaml if already used.
# New installs do not need this overlay or token file.
MOA_APK_TOKEN_FILE=./data/apk-config/token

# Optional VAAPI: append :compose.vaapi.yaml and set the host render group.
MOA_DRI_PATH=/dev/dri
MOA_VAAPI_DEVICE=/dev/dri/renderD128
MOA_RENDER_GID=
# Leave empty for driver detection, or set the driver for your own hardware.
LIBVA_DRIVER_NAME=

# Optional tunnel: append :compose.tunnel.yaml and provide both private files.
TUNNEL_UID=1000
TUNNEL_GID=1000
CF_TUNNEL_CONFIG_FILE=./deploy/local/cloudflared/config.yml
CF_TUNNEL_CREDENTIALS_FILE=./deploy/local/cloudflared/tunnel.json

# Optional server-video storage. Empty uses a dedicated Docker volume.
# Downloads default OFF; configure quota and explicitly enable them in Settings.
MOA_DOWNLOAD_PATH=
# This permits the Settings opt-in; it does not enable downloads by itself.
# Set 0 to block new saves while retaining playback of mounted saved copies.
MOA_DOWNLOADS_ENABLED=1
