{
  "name": "@moa/server",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-extensions.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts test/*/*.test.ts",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:extensions": "tsx scripts/verify-extensions.ts",
    "subtitles:smoke": "tsx scripts/smoke-subtitles.ts",
    "subtitles:directory": "tsx scripts/update-subtitle-directory.ts",
    "validate:season": "tsx validation/skip-markers/season.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@moa/shared": "workspace:*",
    "agent-base": "7.1.4",
    "cheerio": "1.2.0",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.6.1",
    "https-proxy-agent": "7.0.6",
    "iconv-lite": "^0.7.0",
    "linkedom": "0.18.12",
    "quickjs-emscripten-core": "0.32.0",
    "sharp": "^0.34.4",
    "socks": "2.8.10",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/yauzl": "2.10.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
