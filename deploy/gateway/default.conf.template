# Only this gateway is reachable from connectors; auth trusts these normalized headers.
map $http_x_forwarded_proto $moa_proto {
  default $scheme;
  https https;
  http http;
}
# Docker container IPs can change on recreation; refresh service DNS at runtime.
resolver 127.0.0.11 valid=5s ipv6=off;
upstream moa_app {
  zone moa_app 64k;
  server moa:8795 resolve;
}
upstream moa_auth {
  zone moa_auth 64k;
  server moa-auth:8789 resolve;
}

server {
  listen 8080 default_server;
  server_name ${PUBLIC_HOST};
  server_tokens off;
  access_log off;
  client_max_body_size 32m;
  auth_request /__moa/check;
  auth_request_set $moa_account $upstream_http_x_moa_account;
  auth_request_set $moa_role $upstream_http_x_moa_role;
  auth_request_set $moa_permissions $upstream_http_x_moa_permissions;
  auth_request_set $moa_username $upstream_http_x_moa_username;
  auth_request_set $moa_cookie $upstream_http_set_cookie;
  add_header Set-Cookie $moa_cookie always;
  add_header Cache-Control "private, no-store" always;
  add_header X-Content-Type-Options nosniff always;
  # Private server: keep every response out of search engines and archives.
  add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
  error_page 401 = @login;
  proxy_read_timeout 900s;
  proxy_buffering off;
  proxy_set_header X-Moa-Account "";
  proxy_set_header X-Moa-Role "";
  proxy_set_header X-Moa-Permissions "";
  proxy_set_header X-Moa-Username "";
  proxy_set_header Host $http_host;
  proxy_set_header X-Forwarded-Proto $moa_proto;
  proxy_set_header X-Real-IP ${GATEWAY_CLIENT_IP};
  location = /__moa/check {
    internal;
    auth_request off;
    proxy_pass http://moa_auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP ${GATEWAY_CLIENT_IP};
    proxy_set_header X-Forwarded-Proto $moa_proto;
  }
  location ^~ /__moa/ {
    auth_request off;
    proxy_pass http://moa_auth;
  }
  location @login {
    auth_request off;
    rewrite ^ /__moa/required break;
    proxy_pass http://moa_auth;
    proxy_method GET;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP ${GATEWAY_CLIENT_IP};
    proxy_set_header X-Forwarded-Proto $moa_proto;
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
  }
  location = /robots.txt { auth_request off; default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
  location = /manifest.webmanifest { auth_request off; proxy_pass http://moa_app; }
  location ^~ /api/cast/ {
    auth_request off;
    access_log off;
    limit_except GET OPTIONS { deny all; }
    proxy_pass http://moa_app;
    proxy_http_version 1.1;
  }
  location ~ ^/icon(-maskable)?\.svg$ { auth_request off; proxy_pass http://moa_app; }
  location / {
    proxy_pass http://moa_app;
    proxy_http_version 1.1;
    proxy_set_header X-Moa-Account $moa_account;
    proxy_set_header X-Moa-Role $moa_role;
    proxy_set_header X-Moa-Permissions $moa_permissions;
    proxy_set_header X-Moa-Username $moa_username;
    proxy_set_header Accept-Encoding "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP ${GATEWAY_CLIENT_IP};
    proxy_set_header X-Forwarded-Proto $moa_proto;
    sub_filter_once on;
    sub_filter '</head>' '<meta name="moa-auth" content="enabled"></head>';
  }
}

# Private control relay: never published and never routed by the public listener.
# The connector authenticates every request with the shared token.
server {
  listen 8798;
  server_name _;
  access_log off;
  client_max_body_size 16k;
  location = /rpc {
    set $connector_backend moa-connector:8798;
    proxy_pass http://$connector_backend;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
  }
  location / { return 404; }
}
